@model UpdateEmployeeDto
@{
    ViewData["Title"] = "Edit Employee";
}
<h2>Edit Employee</h2>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="bg-white p-4 rounded shadow-sm mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group mb-3">
        <label asp-for="EmployeeCode" class="form-label required"></label>
        <input asp-for="EmployeeCode" class="form-control" />
        <span asp-validation-for="EmployeeCode" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="form-group mb-3 col-md-6">
            <label asp-for="FirstName" class="form-label required"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="form-group mb-3 col-md-6">
            <label asp-for="LastName" class="form-label required"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Email" class="form-label required"></label>
        <input asp-for="Email" class="form-control" type="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Department" class="form-label required"></label>
        <input asp-for="Department" class="form-control" />
        <span asp-validation-for="Department" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="form-group mb-3 col-md-6">
            <label asp-for="Salary" class="form-label required"></label>
            <input asp-for="Salary" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="Salary" class="text-danger"></span>
        </div>
        <div class="form-group mb-3 col-md-6">
            <label asp-for="DateOfJoining" class="form-label required"></label>
            <input asp-for="DateOfJoining" class="form-control" type="date" />
            <span asp-validation-for="DateOfJoining" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
