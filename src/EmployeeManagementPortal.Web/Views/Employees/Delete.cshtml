@model EmployeeDto
@{
    ViewData["Title"] = "Delete Employee";
}
<h2>Delete Employee</h2>
<div class="alert alert-warning">Are you sure you want to delete this employee? This action cannot be undone.</div>
<dl class="row bg-white p-3 rounded shadow-sm">
    <dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.EmployeeCode</dd>
    <dt class="col-sm-3">Full name</dt><dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.Department</dd>
    <dt class="col-sm-3">Salary</dt><dd class="col-sm-9">@Model.Salary.ToString("C")</dd>
</dl>
<form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
