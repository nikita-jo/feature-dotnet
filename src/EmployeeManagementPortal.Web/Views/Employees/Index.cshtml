@model IReadOnlyList<EmployeeDto>
@{
    ViewData["Title"] = "Employees";
}
<div class="d-flex justify-content-between align-items-center mt-4">
    <h2>Employees</h2>
    <a asp-action="Create" class="btn btn-success">+ Add Employee</a>
</div>

<table class="table table-striped table-bordered bg-white mt-3 shadow-sm">
    <thead>
        <tr>
            <th>Code</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Salary</th>
            <th>Date of Joining</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-muted">No employees yet. Click "Add Employee" to get started.</td></tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EmployeeCode</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Department</td>
                    <td>@item.Salary.ToString("C")</td>
                    <td>@item.DateOfJoining.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
