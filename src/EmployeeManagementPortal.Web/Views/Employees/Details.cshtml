@model EmployeeDto
@{
    ViewData["Title"] = "Employee Details";
}
<h2>Employee Details</h2>
<dl class="row bg-white p-3 rounded shadow-sm mt-3">
    <dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.EmployeeCode</dd>
    <dt class="col-sm-3">Full name</dt><dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.Department</dd>
    <dt class="col-sm-3">Salary</dt><dd class="col-sm-9">@Model.Salary.ToString("C")</dd>
    <dt class="col-sm-3">Date of joining</dt><dd class="col-sm-9">@Model.DateOfJoining.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    @if (Model.UpdatedAt.HasValue)
    {
        <dt class="col-sm-3">Updated</dt><dd class="col-sm-9">@Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")</dd>
    }
</dl>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
